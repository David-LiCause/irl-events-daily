# Airtable Personal Access Token — create at https://airtable.com/create/tokens
# Required scopes: data.records:read, data.records:write, schema.bases:write
AIRTABLE_PAT=

# Workspace ID to create the base in — open any base at airtable.com, the
# workspace ID (starts with "wsp") is in the URL or under workspace settings.
AIRTABLE_WORKSPACE_ID=

# Email address the daily digest is sent to — must be your own address.
# The routine must never send the digest anywhere else (see docs/PRD.md
# safety principle). Used for manual/local runs of run-irl-events-daily; the
# scheduled routine gets this value embedded in its prompt at creation time
# instead, since .env is gitignored and isn't present in the routine's
# cloud checkout.
DIGEST_RECIPIENT_EMAIL=
