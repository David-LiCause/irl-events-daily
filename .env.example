# Airtable Personal Access Token — create at https://airtable.com/create/tokens
# Required scopes: data.records:read, data.records:write, schema.bases:write
AIRTABLE_PAT=

# Workspace ID to create the base in — open any base at airtable.com, the
# workspace ID (starts with "wsp") is in the URL or under workspace settings.
AIRTABLE_WORKSPACE_ID=
